    /*
     * Web Audio API Synthesizer with gentle recorder-like envelope
     * Has subtle harmonics for natural wooden flute timbre
     */
    function playReferenceTone(frequency, duration = 1.0) {
      try {
        const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
        const synthCtx = new AudioCtxClass();
        const now = synthCtx.currentTime;

        // Primary fundamental oscillator
        const osc1 = synthCtx.createOscillator();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(frequency, now);

        // Overtone harmonic (2nd harmonic) for woodwind warmth
        const osc2 = synthCtx.createOscillator();
        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(frequency * 2, now);

        // Gain Nodes & Envelopes
        const gainNode = synthCtx.createGain();
        const gainOvertone = synthCtx.createGain();

        gainOvertone.gain.setValueAtTime(0.08, now);

        // Smooth attack and release
        gainNode.gain.setValueAtTime(0.0001, now);
        gainNode.gain.exponentialRampToValueAtTime(0.3, now + 0.08); // Attack
        gainNode.gain.exponentialRampToValueAtTime(0.2, now + 0.25); // Decay / Sustain
        gainNode.gain.exponentialRampToValueAtTime(0.0001, now + duration); // Release

        osc1.connect(gainNode);
        osc2.connect(gainOvertone);
        gainOvertone.connect(gainNode);
        gainNode.connect(synthCtx.destination);

        osc1.start(now);
        osc2.start(now);
        osc1.stop(now + duration + 0.05);
        osc2.stop(now + duration + 0.05);
      } catch (err) {
        console.warn('Reference tone synthesis failed:', err);
      }
    }

    async function startMicrophone() {
      try {
        const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioCtxClass();

        // Prompt for mic stream
        micStream = await navigator.mediaDevices.getUserMedia({
          audio: {
            echoCancellation: false,
            noiseSuppression: false,
            autoGainControl: true
          }
        });

        const sourceNode = audioCtx.createMediaStreamSource(micStream);
        analyserNode = audioCtx.createAnalyser();
        analyserNode.fftSize = 2048;

        // Bandpass filter to focus on Soprano Recorder frequency spectrum (~450Hz to ~1600Hz)
        const biquadFilter = audioCtx.createBiquadFilter();
        biquadFilter.type = 'bandpass';
        biquadFilter.frequency.value = 850;
        biquadFilter.Q.value = 0.7;

        sourceNode.connect(biquadFilter);
        biquadFilter.connect(analyserNode);

        isListening = true;
        updateMicButtonUI(true);
        updateStatusBadge('聆聽吹奏中...', 'bg-emerald-500', 'bg-emerald-50 text-emerald-800');

        // Start processing loop
        processAudioLoop();
      } catch (error) {
        console.error('Microphone access denied or error:', error);
        updateStatusBadge('麥克風存取失敗或未授權', 'bg-rose-500', 'bg-rose-50 text-rose-800');
        tunerFeedback.innerHTML = `<span class="text-rose-600 font-bold">⚠️ 無法取得麥克風權限。請確認瀏覽器允許收音且在安全協定 (HTTPS) 下執行。</span>`;
      }
    }

