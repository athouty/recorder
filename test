    const buffer = new Float32Array(2048);

    function processAudioLoop() {
      if (!isListening || !analyserNode) return;

      analyserNode.getFloatTimeDomainData(buffer);

      // Draw mini oscilloscope waveform
      drawWaveform(buffer);

      // Detect Pitch
      const result = autoCorrelate(buffer, audioCtx.sampleRate);
      const now = performance.now();
      const deltaTime = now - lastPitchTime;
      lastPitchTime = now;

      // Update volume meter
      const volPercent = Math.min(100, Math.round(result.rms * 350));
      volumeMeterBar.style.width = `${volPercent}%`;

      if (result.freq !== -1 && result.rms > 0.02) {
        const pitch = frequencyToPitchDetails(result.freq);

        if (pitch && pitch.inRecorderRange && pitch.closestNote) {
          updatePitchUI(pitch);

          // If in practice mode, optionally follow the played note
          if (currentMode === 'practice') {
            setActiveNote(pitch.closestNote);
          } else {
            // Challenge Game mode logic
            handleChallengePitch(pitch, deltaTime);
          }
        } else {
          // Pitch outside soprano recorder register
          tunerFeedback.textContent = '聲音頻率超出高音直笛範圍';
          tunerFeedback.className = 'mt-1 font-bold text-xs text-amber-600 px-3 py-1 rounded-full bg-amber-50 inline-block';
        }
      } else {
        // No distinct sound
        if (currentMode === 'challenge') {
          // decay challenge hold slowly
          pitchHoldAccumulatedMs = Math.max(0, pitchHoldAccumulatedMs - deltaTime * 0.8);
          updateChallengeProgress();
        }
      }

      requestAnimationFrame(processAudioLoop);
    }

    // Draw live waveform on canvas
    function drawWaveform(timeData) {
      const width = waveformCanvas.width = waveformCanvas.clientWidth * window.devicePixelRatio || 300;
      const height = waveformCanvas.height = 48 * window.devicePixelRatio || 48;

      canvasCtx.clearRect(0, 0, width, height);
      canvasCtx.lineWidth = 2 * window.devicePixelRatio;
      canvasCtx.strokeStyle = '#0d9488';
      canvasCtx.beginPath();

      const sliceWidth = width / timeData.length;
      let x = 0;

      for (let i = 0; i < timeData.length; i += 4) { // step by 4 for lightweight drawing
        const v = timeData[i];
        const y = (v + 1) / 2 * height;
        if (i === 0) {
          canvasCtx.moveTo(x, y);
        } else {
          canvasCtx.lineTo(x, y);
        }
        x += sliceWidth * 4;
      }
      canvasCtx.stroke();
    }

    function updatePitchUI(pitch) {
      const { freq, cents, closestNote } = pitch;

      // Rotate needle: -50 cents = -45 deg, +50 cents = +45 deg
      const clampedCents = Math.max(-50, Math.min(50, cents));
      const needleDeg = (clampedCents / 50) * 45;
      tunerNeedle.style.transform = `rotate(${needleDeg}deg)`;

      // Big Note Badge Update
      detectedNoteName.textContent = closestNote.name;
      detectedSolfege.textContent = closestNote.solfege;
      freqText.textContent = `目前頻率: ${freq} Hz (目標: ${closestNote.freq} Hz)`;

      // Cents sign formatting
      const sign = cents > 0 ? `+${cents}` : `${cents}`;
      centsText.textContent = `${sign} ¢`;

      // Status intonation coloring & comments
      if (Math.abs(cents) <= 10) {
        // Perfectly in-tune!
        centsText.className = 'text-sm font-mono font-black text-emerald-600';
        noteBadge.className = 'w-32 h-32 rounded-3xl bg-emerald-50 border-4 border-emerald-400 flex flex-col items-center justify-center shadow-lg shadow-emerald-400/20 transition duration-150 pop-in';
        detectedNoteName.className = 'text-4xl font-black text-emerald-700 tracking-tight';
        detectedSolfege.className = 'text-sm font-bold text-emerald-600 mt-0.5';
        tunerFeedback.innerHTML = `<span class="text-emerald-700 font-black">🎉 音準極佳！(Perfect)</span>`;
        tunerFeedback.className = 'mt-1 font-bold text-sm text-emerald-700 px-4 py-1 rounded-full bg-emerald-100 inline-block shadow-sm';
      } else if (cents > 10) {
        // Sharp (Too high)
        centsText.className = 'text-sm font-mono font-black text-amber-600';
        noteBadge.className = 'w-32 h-32 rounded-3xl bg-amber-50 border-4 border-amber-300 flex flex-col items-center justify-center shadow transition duration-150';
        detectedNoteName.className = 'text-4xl font-black text-amber-700 tracking-tight';
        detectedSolfege.className = 'text-sm font-bold text-amber-600 mt-0.5';
        tunerFeedback.innerHTML = `<span class="text-amber-800 font-bold">⬆️ 音偏高，氣流放柔或嘴唇微放鬆</span>`;
        tunerFeedback.className = 'mt-1 font-bold text-sm text-amber-800 px-3 py-1 rounded-full bg-amber-100 inline-block';
      } else {
        // Flat (Too low)
        centsText.className = 'text-sm font-mono font-black text-sky-600';
        noteBadge.className = 'w-32 h-32 rounded-3xl bg-sky-50 border-4 border-sky-300 flex flex-col items-center justify-center shadow transition duration-150';
        detectedNoteName.className = 'text-4xl font-black text-sky-700 tracking-tight';
        detectedSolfege.className = 'text-sm font-bold text-sky-600 mt-0.5';
        tunerFeedback.innerHTML = `<span class="text-sky-800 font-bold">⬇️ 音偏低，氣流稍加集中或檢查按孔是否漏氣</span>`;
        tunerFeedback.className = 'mt-1 font-bold text-sm text-sky-800 px-3 py-1 rounded-full bg-sky-100 inline-block';
      }
    }

    function setChallengeTarget(index) {
      if (index < 0) index = challengeQueue.length - 1;
      if (index >= challengeQueue.length) index = 0;
      challengeIndex = index;
      const target = challengeQueue[challengeIndex];

      targetNoteBadge.textContent = target.name;
      targetNoteSolfege.textContent = `(${target.solfege.split(' ')[0]})`;
      targetNoteTip.textContent = target.tip;

      // Point the recorder visualization to target note for student instruction
      setActiveNote(target);
      pitchHoldAccumulatedMs = 0;
      updateChallengeProgress();
    }

    function handleChallengePitch(pitch, deltaTime) {
      const target = challengeQueue[challengeIndex];

      // Check if the detected note matches target AND is reasonably in-tune (within 20 cents)
      const isCorrectNote = pitch.closestNote.id === target.id;
      const isInTune = Math.abs(pitch.cents) <= 22;

      if (isCorrectNote && isInTune) {
        pitchHoldAccumulatedMs += deltaTime;
        if (pitchHoldAccumulatedMs >= REQUIRED_HOLD_MS) {
          triggerLevelSuccess();
        }
      } else {
        // Gradually drop progress if slipping
        pitchHoldAccumulatedMs = Math.max(0, pitchHoldAccumulatedMs - deltaTime * 0.5);
      }
      updateChallengeProgress();
    }

    function updateChallengeProgress() {
      const percentage = Math.min(100, Math.round((pitchHoldAccumulatedMs / REQUIRED_HOLD_MS) * 100));
      holdProgressText.textContent = `${percentage}%`;
      holdProgressCircle.setAttribute('stroke-dasharray', `${percentage}, 100`);

      if (percentage >= 80) {
        holdProgressCircle.setAttribute('class', 'text-emerald-500 transition-all duration-75');
      } else {
        holdProgressCircle.setAttribute('class', 'text-indigo-600 transition-all duration-75');
      }
    }

    function triggerLevelSuccess() {
      pitchHoldAccumulatedMs = 0;
      updateChallengeProgress();
      challengeScore += 10;
      scoreCounter.textContent = challengeScore;

      // Play joyful success chime
      playSuccessSound();

      // Confetti visual feedback on challenge card
      challengeCard.classList.add('ring-4', 'ring-emerald-400', 'bg-emerald-50/50');
      setTimeout(() => {
        challengeCard.classList.remove('ring-4', 'ring-emerald-400', 'bg-emerald-50/50');
      }, 700);

      // Advance to next target note after brief pause
      setChallengeTarget(challengeIndex + 1);
    }

    function playSuccessSound() {
      try {
        const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
        const chimeCtx = new AudioCtxClass();
        const now = chimeCtx.currentTime;

        const chord = [523.25, 659.25, 783.99, 1046.50]; // C Major arpeggio
        chord.forEach((freq, idx) => {
          const osc = chimeCtx.createOscillator();
          const gain = chimeCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.08);

          gain.gain.setValueAtTime(0.001, now + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.25, now + idx * 0.08 + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.08 + 0.5);

          osc.connect(gain);
          gain.connect(chimeCtx.destination);
          osc.start(now + idx * 0.08);
          osc.stop(now + idx * 0.08 + 0.55);
        });
      } catch (e) {
        console.warn('Audio chime note failed:', e);
      }
    }

    function setupEventListeners() {
      // Toggle Microphone
      micToggleBtn.addEventListener('click', () => {
        if (!isListening) {
          startMicrophone();
        } else {
          stopMicrophone();
        }
      });

      // System Switch: Baroque vs German
      btnBaroque.addEventListener('click', () => {
        currentSystem = 'B';
        btnBaroque.className = 'px-3 py-1.5 rounded-lg bg-teal-600 text-white transition';
        btnGerman.className = 'px-3 py-1.5 rounded-lg hover:bg-slate-100 transition';
        renderRecorderFingering(currentActiveNote);
      });

      btnGerman.addEventListener('click', () => {
        currentSystem = 'G';
        btnGerman.className = 'px-3 py-1.5 rounded-lg bg-teal-600 text-white transition';
        btnBaroque.className = 'px-3 py-1.5 rounded-lg hover:bg-slate-100 transition';
        renderRecorderFingering(currentActiveNote);
      });

      // Mode Switch: Free practice vs Challenge
      modePracticeBtn.addEventListener('click', () => {
        currentMode = 'practice';
        modePracticeBtn.className = 'px-3 py-1.5 rounded-lg bg-teal-600 text-white transition';
        modeChallengeBtn.className = 'px-3 py-1.5 rounded-lg hover:bg-slate-100 transition';
        challengeCard.classList.add('opacity-50');
      });

      modeChallengeBtn.addEventListener('click', () => {
        currentMode = 'challenge';
        modeChallengeBtn.className = 'px-3 py-1.5 rounded-lg bg-teal-600 text-white transition';
        modePracticeBtn.className = 'px-3 py-1.5 rounded-lg hover:bg-slate-100 transition';
        challengeCard.classList.remove('opacity-50');
        setChallengeTarget(challengeIndex);
      });

      // Reference Sound Button
      btnPlayRef.addEventListener('click', () => {
        if (currentActiveNote) {
          playReferenceTone(currentActiveNote.freq, 1.2);
        }
      });

      // Challenge Buttons
      btnPrevLevel.addEventListener('click', () => setChallengeTarget(challengeIndex - 1));
      btnNextLevel.addEventListener('click', () => setChallengeTarget(challengeIndex + 1));
    }

    // Start on Window Load
    window.onload = function () {
      populateQuickNotesBar();
      renderRecorderFingering(currentActiveNote);
      setupEventListeners();
      setChallengeTarget(0);
    };
  </script>
</body>
