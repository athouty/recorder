    /*
     * Autocorrelation pitch detection algorithm:
     * Finds the primary repeating period (lag) in an audio buffer.
     * Well-suited for monophonic wooden flute / recorder woodwind instruments.
     */
    function autoCorrelate(buffer, sampleRate) {
      const SIZE = buffer.length;

      // Step 1: Calculate Root Mean Square (RMS) energy to reject silence & noise
      let sumSquares = 0;
      for (let i = 0; i < SIZE; i++) {
        const val = buffer[i];
        sumSquares += val * val;
      }
      const rms = Math.sqrt(sumSquares / SIZE);
      if (rms < 0.015) { // Silence or background noise threshold
        return { freq: -1, rms: rms };
      }

      // Step 2: Trim buffer to zero crossings to minimize boundary artifacts
      let r1 = 0, r2 = SIZE - 1;
      const thres = 0.2;
      for (let i = 0; i < SIZE / 2; i++) {
        if (Math.abs(buffer[i]) < thres) {
          r1 = i;
          break;
        }
      }
      for (let i = 1; i < SIZE / 2; i++) {
        if (Math.abs(buffer[SIZE - i]) < thres) {
          r2 = SIZE - i;
          break;
        }
      }
      const trimmedBuffer = buffer.slice(r1, r2);
      const c = new Float32Array(trimmedBuffer.length).fill(0);

      // Step 3: Compute autocorrelation coefficients
      for (let i = 0; i < trimmedBuffer.length; i++) {
        for (let j = 0; j < trimmedBuffer.length - i; j++) {
          c[i] = c[i] + trimmedBuffer[j] * trimmedBuffer[j + i];
        }
      }

      // Step 4: Skip the zero-lag peak and find the first local maximum
      let d = 0;
      while (c[d] > c[d + 1]) {
        d++;
        if (d >= c.length - 1) return { freq: -1, rms: rms };
      }

      let maxval = -1, maxpos = -1;
      for (let i = d; i < c.length; i++) {
        if (c[i] > maxval) {
          maxval = c[i];
          maxpos = i;
        }
      }

      if (maxpos === -1 || maxval === 0) return { freq: -1, rms: rms };

      // Step 5: Parabolic interpolation for sub-bin frequency accuracy
      let T0 = maxpos;
      if (maxpos > 0 && maxpos < c.length - 1) {
        const alpha = c[maxpos - 1];
        const beta = c[maxpos];
        const gamma = c[maxpos + 1];
        const delta = (alpha - gamma) / (2 * (alpha - 2 * beta + gamma));
        if (!isNaN(delta)) {
          T0 = maxpos + delta;
        }
      }

      const frequency = sampleRate / T0;
      return { freq: frequency, rms: rms };
    }

    /*
     * Calculate closest note and cents deviation (-50 to +50 cents)
     */
    function frequencyToPitchDetails(freq) {
      if (freq <= 0) return null;

      // Note number relative to A4 (440Hz)
      const noteNum = 12 * (Math.log(freq / 440) / Math.log(2));
      const roundedNote = Math.round(noteNum);
      const cents = Math.round((noteNum - roundedNote) * 100);

      // Match closest note in our recorder dictionary
      let closestNote = null;
      let minFreqDiff = Infinity;
      for (const note of NOTES_DATA) {
        const diff = Math.abs(note.freq - freq);
        if (diff < minFreqDiff) {
          minFreqDiff = diff;
          closestNote = note;
        }
      }

      // Check if frequency is within reasonable soprano recorder window (~480Hz to 1500Hz)
      const inRecorderRange = freq >= 480 && freq <= 1500;

      return {
        freq: Math.round(freq * 10) / 10,
        cents: cents,
        closestNote: closestNote,
        inRecorderRange: inRecorderRange
      };
    }

